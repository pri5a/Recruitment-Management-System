<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Recruiter_Required_When_Status_Open</fullName>
    <active>true</active>
    <errorConditionFormula>AND( ISPICKVAL( Status__c , &quot;Open&quot;) ,  ISBLANK( Recruiter__c ))</errorConditionFormula>
    <errorDisplayField>Recruiter__c</errorDisplayField>
    <errorMessage>Select a Recruiter before opening a job.</errorMessage>
</ValidationRule>
