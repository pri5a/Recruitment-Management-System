<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Hiring_Manager_required_when_status_Open</fullName>
    <active>true</active>
    <errorConditionFormula>AND( ISPICKVAL( Status__c , &quot;Open&quot;), ISBLANK( Hiring_Manager__c))</errorConditionFormula>
    <errorDisplayField>Hiring_Manager__c</errorDisplayField>
    <errorMessage>Select a Hiring Manager before opening a job.</errorMessage>
</ValidationRule>
