<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Location_Required_when_Status_Open</fullName>
    <active>true</active>
    <errorConditionFormula>AND( ISPICKVAL( Status__c , &quot;Open&quot;) ,  ISBLANK( Location__c ) )</errorConditionFormula>
    <errorDisplayField>Location__c</errorDisplayField>
    <errorMessage>Enter a location before opening a job.</errorMessage>
</ValidationRule>
